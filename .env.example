# Required - OpenAI API for GPT-4o vision
OPENAI_API_KEY=sk-...

# Optional - Rate limiting storage directory
# Default: /data/ratelimit (Fly persistent volume)
# For local dev, use: /tmp/ratelimit
RATELIMIT_STORAGE_DIR=/data/ratelimit

# Optional - Cloudflare R2 for data lake storage
# If not set, image logging will be disabled
CF_R2_DATA_LAKE_URL=https://...
CF_R2_DATA_LAKE_ACCESS_KEY_ID=...
CF_R2_DATA_LAKE_SECRET_ACCESS_KEY=...
